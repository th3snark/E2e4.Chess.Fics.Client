<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>E2e4 FICS Client</Product>
    <Description>Cross-platform client library for the Free Internet Chess Server (FICS): framing, typed message parsing, style-12 boards and an optional pluggable timeseal codec. Unofficial; not affiliated with FICS.</Description>
    <PackageTags>chess;fics;freechess;telnet;style12;timeseal</PackageTags>
    <PackageReleaseNotes>1.0.0: first release, split out of https://github.com/th3snark/E2e4.Chess. A FICS client for .NET 10: System.IO.Pipelines framing (with optional block mode), a typed message parser, style-12 board parsing, IFicsClient and IFicsClientFactory with dependency injection (AddFicsClient), a TCP transport behind an IFicsTransport seam, and an optional pluggable timeseal codec (ITimesealCodec; the package has no GPL dependency). Outbound lines containing CR, LF or NUL are rejected, inbound lines have length caps, and optional ILogger output never includes raw lines or passwords.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/th3snark/E2e4.Chess.Fics.Client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/th3snark/E2e4.Chess.Fics.Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E2e4.Chess.Fics.Client.Test" />
  </ItemGroup>

  <!-- nuget.org drops raw HTML such as the README's <img> icon and shows it as text, so the packed README is a copy without that line (GitHub keeps it). -->
  <Target Name="PackReadmeWithoutIcon" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <PackedReadme>$(MSBuildProjectDirectory)/obj/nuget/README.md</PackedReadme>
      <PackedReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</PackedReadmeText>
      <PackedReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(PackedReadmeText)', '(?m)^&lt;img [^\r\n]*\r?\n', ''))</PackedReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape('$(PackedReadmeText)'))" Overwrite="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>
