<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>E2e4 FICS Client</Product>
    <Description>Cross-platform client library for the Free Internet Chess Server (FICS): framing, typed message parsing, style-12 boards and an optional pluggable timeseal codec. Unofficial; not affiliated with FICS.</Description>
    <PackageTags>chess;fics;freechess;telnet;style12;timeseal</PackageTags>
    <PackageReleaseNotes>See https://github.com/th3snark/E2e4.Chess.Fics.Client/releases for what changed in each version.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/th3snark/E2e4.Chess.Fics.Client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/th3snark/E2e4.Chess.Fics.Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E2e4.Chess.Fics.Client.Test" />
  </ItemGroup>

  <!-- nuget.org renders neither raw HTML nor relative paths, and shows images only from allowed hosts (raw.githubusercontent.com is one).
       The packed README is a copy whose icon <img> is a Markdown image on a raw URL pinned to the release tag (GitHub keeps the original). -->
  <Target Name="PackReadme" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <RepoRaw>https://raw.githubusercontent.com/th3snark/E2e4.Chess.Fics.Client/v$(Version)/</RepoRaw>
      <PackedReadme>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)nuget/README.md</PackedReadme>
      <PackedReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</PackedReadmeText>
      <PackedReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(PackedReadmeText)', '(?m)^&lt;img src="([^"]+)" alt="([^"]*)"[^\r\n]*', '![$2]($(RepoRaw)$1)'))</PackedReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape('$(PackedReadmeText)'))" Overwrite="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>
